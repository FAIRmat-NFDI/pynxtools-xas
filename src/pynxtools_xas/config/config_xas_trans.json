  "/ENTRY/energy": "@data:energy",
  "/ENTRY/energy/@units": "eV",
  "/ENTRY/intensity": "@data:intensity",

  "/ENTRY/SAMPLE[sample]/name": "['@attrs:sample_name', '@eln']",

  "/ENTRY/INSTRUMENT[instrument]/SOURCE[source]/name": "@attrs:source_name",
  "/ENTRY/INSTRUMENT[instrument]/SOURCE[source]/type": "@attrs:source_type",
